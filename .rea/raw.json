br>"},"id":"bqdm32ih","desktop":{"animation":{"delay":0,"duration":2,"name":"zoomIn","repeat":null},"fontSize":"18"},"mobile":{"animation":{"delay":0,"duration":2,"name":"zoomIn","repeat":null},"fontSize":"18"},"$parent":"o1lk6qej"}},"extra_css":"/* --- Vị trí và Kiểu dáng Icon (Luôn cố định dưới bên trái) --- */\r\n.music-icon {\r\n    position: fixed;\r\n    bottom: 20px;\r\n    left: 20px;\r\n    width: 50px;\r\n    height: 50px;\r\n    cursor: pointer;\r\n    z-index: 1000;\r\n    border-radius: 50%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background-color: #fff;\r\n    box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n/* Kiểu dáng Hình ảnh Icon */\r\n.music-icon img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    border-radius: 50%;\r\n    transition: transform 0.3s ease;\r\n    position: relative;\r\n    z-index: 2;\r\n}\r\n\r\n/* --- Thanh Gạch Chéo (Khi TẮT) --- */\r\n.slash-line {\r\n    position: absolute;\r\n    width: 90%;\r\n    height: 3px;\r\n    background-color: #000000;\r\n    transform: rotate(45deg);\r\n    transition: opacity 0.3s ease;\r\n    z-index: 3;\r\n    opacity: 0; \r\n}\r\n\r\n/* Icon khi nhạc đang TẮT (paused) */\r\n.music-icon.paused .slash-line {\r\n    opacity: 1; /* Hiện gạch chéo */\r\n}\r\n\r\n/* --- Hiệu ứng Xoay (Khi PHÁT) --- */\r\n.music-icon.playing img {\r\n    animation: spin 5s linear infinite; /* Kích hoạt hiệu ứng xoay liên tục */\r\n}\r\n\r\n@keyframes spin {\r\n    from {\r\n        transform: rotate(0deg);\r\n    }\r\n    to {\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n\r\n\r\n","extra_script":"const musicBtn = document.getElementById(&quot;music-btn&quot;);\r\nconst music = document.getElementById(&quot;bg-music&quot;);\r\nlet isPlaying = false;\r\n\r\n// Click vào nút bật/tắt nhạc\r\nmusicBtn.addEventListener(&quot;click&quot;, () =&gt; {\r\n  if (isPlaying) {\r\n    music.pause();\r\n    musicBtn.classList.remove(&quot;active&quot;);\r\n    musicBtn.classList.add(&quot;paused&quot;);\r\n  } else {\r\n    music.play().then(() =&gt; {\r\n      musicBtn.classList.add(&quot;active&quot;);\r\n      musicBtn.classList.remove(&quot;paused&quot;);\r\n    }).catch(err =&gt; console.log(&quot;User interaction required:&quot;, err));\r\n  }\r\n  isPlaying = !isPlaying;\r\n});\r\n\r\n// 👉 Tự động phát khi user tương tác bất kỳ trên trang\r\ndocument.body.addEventListener(&quot;click&quot;, () =&gt; {\r\n  if (!isPlaying) {\r\n    music.play().then(() =&gt; {\r\n      musicBtn.classList.add(&quot;active&quot;);\r\n      musicBtn.classList.remove(&quot;paused&quot;);\r\n      isPlaying = true;\r\n    }).catch(err =&gt; {});\r\n  }\r\n}, { once: true });\r\n\r\n\r\n\r\n\r\n"}}